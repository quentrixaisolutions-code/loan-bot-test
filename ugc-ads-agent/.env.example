# ---- Copy this file to ".env" and fill in the values ----

# --- Claude (Anthropic) ---
# Get this from https://console.anthropic.com  ->  Settings  ->  API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Default is claude-sonnet-5 (good balance of quality/cost for
# creative writing + vision review). claude-opus-5 is stronger but pricier;
# claude-haiku-4-5 is cheaper/faster for quick iteration.
# (Prefixed UGC_ because plain CLAUDE_EFFORT can already be set by some
# hosts/tooling for unrelated purposes.)
# UGC_CLAUDE_MODEL=claude-sonnet-5
# UGC_CLAUDE_EFFORT=medium

# --- Higgsfield ---
# Sign up at https://higgsfield.ai, then generate a server-side API key pair
# from Higgsfield Cloud (see docs.higgsfield.ai). Format is two parts: a key
# ID and a key secret.
#
# Leave these BLANK to run in DRY-RUN mode: the whole pipeline (concepts ->
# "generation" -> review -> regenerate) works end-to-end using placeholder
# media, so you can build/test the app before you have Higgsfield access.
# HIGGSFIELD_KEY_ID=
# HIGGSFIELD_KEY_SECRET=

# --- Dashboard access ---
# Any hard-to-guess string. The dashboard and its API are gated behind this key.
DASHBOARD_KEY=pick-a-long-random-string

# --- Optional tuning ---
# How many ad variants (angles) to generate per campaign by default.
# DEFAULT_VARIANTS=3

# How often (ms) to poll Higgsfield for a generation's status.
# POLL_INTERVAL_MS=5000

# Give up on a single generation after this long (ms).
# POLL_TIMEOUT_MS=600000

# Where campaigns.json is written. On a host with ephemeral disks, point this
# at a mounted volume so campaigns survive redeploys.
# DATA_DIR=data

# PORT=3000
