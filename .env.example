# ---- Copy this file to ".env" and fill in the values ----
# (On Railway you paste these into the service's "Variables" tab instead.)

# --- Claude (Anthropic) ---
# Get this from https://console.anthropic.com  ->  Settings  ->  API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Default is claude-opus-5 (most capable).
# For a cheaper, faster FAQ bot use:  claude-haiku-4-5
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_EFFORT=low
# CLAUDE_MAX_TOKENS=1024

# --- Twilio ---
# From https://console.twilio.com  (Account Info panel on the dashboard)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# The Twilio WhatsApp Sandbox number, in this exact format (keep "whatsapp:")
# You'll see it in Console -> Messaging -> Try it out -> Send a WhatsApp message
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Lead viewer ---
# Any hard-to-guess string. You'll open  /leads?key=THIS_VALUE
DASHBOARD_KEY=pick-a-long-random-string

# --- Optional hardening (safe to leave as-is while testing) ---
# Verify each webhook is really from Twilio. If you turn this on, PUBLIC_URL
# must be the exact public URL of this service.
# VALIDATE_TWILIO_SIGNATURE=false
# PUBLIC_URL=https://your-app.up.railway.app

# Where lead/conversation files are written. On Railway, set this to a mounted
# volume path (e.g. /data) so data survives redeploys.
# DATA_DIR=data

# Port (Railway sets this automatically; locally it defaults to 3000)
# PORT=3000
